# Example values only. No variable here is a secret.
HANDBOOK_DIR=/handbook
REDACT_PAGE_FILES=
REDACT_EMAIL_ALLOW_DOMAINS=digitiamo.com
GUIDES_REPO_URL=/guides-src
GUIDES_BRANCH=master
GUIDES_CHECKOUT_DIR=/app/.cache/guides
ARTIFACT_DIR=/app/artifacts
# gcs on Cloud Run (D-06): the server reads <prefix>index.manifest.json then index-<build_id>.db from the private bucket; compose and kind use local (D-10)
ARTIFACT_STORE=local
ARTIFACT_BUCKET=
ARTIFACT_PREFIX=
# private bucket for Guides videos (D-16); when set, run rewrites video URLs to https://storage.cloud.google.com/<bucket>/videos/<name>.mp4 and upload-videos must have uploaded them
VIDEO_BUCKET=

# MCP server (services/mcp_server). Secrets (Google client secret, JWT signing key, OAuth state
# encryption key) are not listed here: set them in .env or a secret manager only.
GUIDES_WEB_BASE=https://github.com/example-org/guides
MCP_HOST=0.0.0.0
PORT=8000
# local enables AUTH_MODE=off / MCP_AUTH=none; unset or production on every deployed host; refused when K_SERVICE is set
DEPLOY_ENV=local
# AUTH_MODE=off needs DEPLOY_ENV=local; DEPLOY_ENV=local is refused when K_SERVICE is set (D-13).
AUTH_MODE=off
MCP_PUBLIC_BASE_URL=http://localhost:8000
# extra bare hostnames the server answers on plain http, e.g. the Service name mcp-server in compose and kind
MCP_ALLOWED_HOSTS=
GOOGLE_CLIENT_ID=
ALLOWED_EMAIL_DOMAIN=digitiamo.com
BOT_SA_EMAILS=
OAUTH_STORAGE=memory
OAUTH_COLLECTION=oauth_state
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=30
GAP_TTL_DAYS=90
GAP_COLLECTION=gaps
GOOGLE_CLOUD_PROJECT=demo-ai-buddy

# Chat bot (services/chat_bot). Example values only. THREAD_KEY_SECRET, ANTHROPIC_API_KEY and
# MERIDIAN_API_KEY are secrets: set them in .env or a secret manager, never in this file.
# Comma-separated Chat user ids; LLM_BACKEND=meridian requires exactly one (D1a).
ALLOWED_USERS=users/000000000000000000000
LLM_BACKEND=meridian
LLM_BASE_URL=http://meridian:3456
VERTEX_PROJECT=
VERTEX_REGION=
REFORMULATE_MODEL=claude-haiku-5-5
ANSWER_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_SECONDS=60
CONFIDENCE_THRESHOLD=0.7
MEMORY_TURNS=3
MEMORY_COLLECTION=thread_memory
# Compose and kind call the MCP server by its Service name; the server admits that host on plain
# http through MCP_ALLOWED_HOSTS=mcp-server (its Host guard answers 421 for any other name).
MCP_URL=http://mcp-server:8000/mcp
# MCP_AUTH=none needs DEPLOY_ENV=local (the bot enforces its half from 04-03) and is refused when K_SERVICE is set.
MCP_AUTH=none
# With MCP_AUTH=google_id_token, MCP_AUDIENCE is the server's MCP_PUBLIC_BASE_URL.
MCP_AUDIENCE=
INTAKE=pubsub
PUBSUB_SUBSCRIPTION=projects/demo-ai-buddy/subscriptions/chat-events
# With INTAKE=http: the Chat app's audience and the Chat service account e-mail.
CHAT_JWT_AUDIENCE=
CHAT_JWT_ISSUER_EMAIL=
BOT_HOST=0.0.0.0
# Placeholder: the real HTTPS image URL is supplied in .env at the 03-12 live checkpoint.
VIDEO_THUMBNAIL_URL=https://example.invalid/video-thumbnail.png
HELP_COMMAND_ID=
RUN_DEADLINE_SECONDS=120
# Must stay false: the bot refuses to start otherwise (prompts must not leave the host).
LANGSMITH_TRACING=false
